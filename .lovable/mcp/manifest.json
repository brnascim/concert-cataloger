{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fvpxvbklwtxtlzmlytkd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "setlist-symphony",
      "version": "0.1.0",
      "title": "Setlist Symphony"
    },
    "tools": [
      {
        "name": "list_processings",
        "title": "List processing runs",
        "description": "List the signed-in user's file processing runs with their extraction statistics.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Maximum number of runs to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_shows",
        "title": "List shows",
        "description": "List catalogued live shows for the signed-in user, optionally filtered by artist, city or processing run.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "artist": {
              "type": "string",
              "description": "Filter by artist name (partial match)."
            },
            "city": {
              "type": "string",
              "description": "Filter by city name (partial match)."
            },
            "processingId": {
              "type": "string",
              "description": "Restrict to one processing run id."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum number of shows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_setlist_songs",
        "title": "List setlist songs",
        "description": "List songs from the signed-in user's setlists, optionally filtered by processing run, setlist number or title.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "processingId": {
              "type": "string",
              "description": "Restrict to one processing run id."
            },
            "setListNumber": {
              "type": "integer",
              "description": "Restrict to one setlist number."
            },
            "title": {
              "type": "string",
              "description": "Filter by song title (partial match)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 100,
              "description": "Maximum number of songs to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_processing_errors",
        "title": "List processing errors",
        "description": "List parsing/processing errors recorded for the signed-in user's uploads.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "processingId": {
              "type": "string",
              "description": "Restrict to one processing run id."
            },
            "onlyUnresolved": {
              "type": "boolean",
              "default": false,
              "description": "Return only errors that are not marked resolved."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum number of errors to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
